# ============================================================
#  .env.example — mẫu AN TOÀN để commit
#  Sao chép thành .env (root), contracts/.env,
#  backend/.env, frontend/.env.local rồi điền giá trị thật.
# ============================================================

# --- Chain ---
CHAIN_ID=11155111
CHAIN_ID_HEX=0xaa36a7
CHAIN_NAME=Sepolia
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<INFURA_PROJECT_ID>
SEPOLIA_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=<ETHERSCAN_API_KEY>
ETHERSCAN_BASE_URL=https://sepolia.etherscan.io

# --- Ví deploy / issuer ---
DEPLOYER_ADDRESS=0x...
ISSUER_ADDRESS=0x...
OWNER_ADDRESS=0x...
DEPLOYER_PRIVATE_KEY=<PRIVATE_KEY_CHI_LUU_LOCAL>

# --- Contract (cập nhật sau deploy) ---
CONTRACT_ADDRESS=0x...
DEPLOY_BLOCK=0

# --- MongoDB Atlas ---
MONGODB_USER=<DB_USER>
MONGODB_PASS=<DB_PASSWORD>
MONGODB_DB=verify_cert
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/verify_cert?retryWrites=true&w=majority

# --- Pinata / IPFS ---
PINATA_API_KEY=<PINATA_API_KEY>
PINATA_API_SECRET=<PINATA_API_SECRET>
PINATA_JWT=<PINATA_JWT>
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# --- Backend ---
NODE_ENV=development
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=<RANDOM_64_HEX>
JWT_EXPIRES_IN=7d
MAX_FILE_SIZE_MB=5

# --- Seed demo ---
SEED_ADMIN_EMAIL=admin@verifycert.local
SEED_ADMIN_PASSWORD=<DOI_MAT_KHAU>
SEED_ISSUER_EMAIL=issuer@verifycert.local
SEED_ISSUER_PASSWORD=<DOI_MAT_KHAU>

# --- Frontend (chỉ NEXT_PUBLIC_*) ---
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_ID_HEX=0xaa36a7
NEXT_PUBLIC_CHAIN_NAME=Sepolia
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...
NEXT_PUBLIC_DEPLOY_BLOCK=0
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
